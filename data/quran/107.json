{
  "number": 107,
  "ayahs": [
    {
      "number": 1,
      "arabic": "اَرَءَيْتَ الَّذِيْ يُكَذِّبُ بِالدِّيْنِ ۝١ؕ",
      "bengali": "তুমি কি তাকে দেখেছ, যে কর্মফল (দিবসকে) অস্বীকার করে?"
    },
    {
      "number": 2,
      "arabic": "فَذٰلِكَ الَّذِيْ يَدُعُّ الْيَتِيْمَ ۝٢ۙ",
      "bengali": "সে তো সেই (লোক) যে ইয়াতীমকে ধাক্কা দিয়ে সরিয়ে দেয়,"
    },
    {
      "number": 3,
      "arabic": "وَلَا يَحُضُّ عَلٰي طَعَامِ الْمِسْكِيْنِ ۝٣ؕ",
      "bengali": "এবং মিসকীনকে অন্ন দিতে উৎসাহ দেয় না"
    },
    {
      "number": 4,
      "arabic": "فَوَيْلٌ لِّلْمُصَلِّيْنَ ۝٤ۙ",
      "bengali": "অতএব দুর্ভোগ সে সব নামায আদায়কারীর"
    },
    {
      "number": 5,
      "arabic": "الَّذِيْنَ هُمْ عَنْ صَلَاتِهِمْ سَاهُوْنَ ۝٥ۙ",
      "bengali": "যারা নিজেদের নামাযের ব্যাপারে উদাসীন,"
    },
    {
      "number": 6,
      "arabic": "الَّذِيْنَ هُمْ يُرَا࢜ءُوْنَ ۝٦ۙ",
      "bengali": "যারা লোক দেখানোর জন্য তা করে,"
    },
    {
      "number": 7,
      "arabic": "وَيَمْنَعُوْنَ الْمَاعُوْنَ ۝٧ࣖ",
      "bengali": "এবং প্রয়োজনীয় গৃহসামগ্রী দানের ছোট খাট সাহায্য করা থেকেও বিরত থাকে।"
    }
  ]
}
