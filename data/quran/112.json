{"number":112,"ayahs":[{"number":1,"arabic":"قُلۡ هُوَ ٱللَّهُ أَحَدٌ","bengali":"বলুন, তিনি আল্লাহ, এক"},{"number":2,"arabic":"ٱللَّهُ ٱلصَّمَدُ","bengali":"আল্লাহ অমুখাপেক্ষী"},{"number":3,"arabic":"لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ","bengali":"তিনি কাউকে জন্ম দেননি এবং কেউ তাকে জন্ম দেয়নি"},{"number":4,"arabic":"وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ","bengali":"এবং তার সমতুল্য কেউ নেই।"}]}