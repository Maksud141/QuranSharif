    {
      "number": 6,
      "arabic": "مِنَ الْجِنَّةِ وَالنَّاسِ ۝٦ࣖ",
      "bengali": "(এই কুমন্ত্রণাদাতা হচ্ছে) জিন্নের মধ্য হতে এবং মানুষের মধ্য হতে।"
    }
