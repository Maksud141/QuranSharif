      "arabic": "قُلْ اَعُوْذُ بِرَبِّ النَّاسِ ۝١ۙ",
      "bengali": "বল, ‘আমি আশ্রয় চাচ্ছি মানুষের প্রতিপালকের,"
    },
    {
      "number": 2,
      "arabic": "مَلِكِ النَّاسِ ۝٢ۙ",
      "bengali": "মানুষের অধিপতির,"
    },
    {
      "number": 3,
      "arabic": "اِلٰهِ النَّاسِ ۝٣ۙ",
      "bengali": "মানুষের প্রকৃত ইলাহর,"
    },
    {
      "number": 4,
      "arabic": "مِنْ شَرِّ الْوَسْوَاسِ࣢ۙ الْخَنَّاسِ ۝٤ࣕۙ",
