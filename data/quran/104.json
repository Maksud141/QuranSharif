{"number":104,"ayahs":[{"number":1,"arabic":"وَيۡلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ","bengali":"প্রত্যেক পশ্চাতে ও সম্মুখে পরনিন্দাকারীর দুর্ভোগ"},{"number":2,"arabic":"ٱلَّذِي جَمَعَ مَالٗا وَعَدَّدَهُۥ","bengali":"যে অর্থ সঞ্চিত করে ও গণনা করে"},{"number":3,"arabic":"يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ","bengali":"সে মনে করে যে, তার অর্থ চিরকাল তার সাথে থাকবে"},{"number":4,"arabic":"كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ","bengali":"কখনও না, সে অবশ্যই নিক্ষিপ্ত হবে পিষ্টকারীর মধ্যে।"},{"number":5,"arabic":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ","bengali":"আপনি কি জানেন, পিষ্টকারী কি"},{"number":6,"arabic":"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ","bengali":"এটা আল্লাহর প্রজ্জ্বলিত অগ্নি"},{"number":7,"arabic":"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ","bengali":"যা হৃদয় পর্যন্ত পৌছবে।"},{"number":8,"arabic":"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةٞ","bengali":"এতে তাদেরকে বেঁধে দেয়া হবে"},{"number":9,"arabic":"فِي عَمَدٖ مُّمَدَّدَةِۭ","bengali":"লম্বা লম্বা খুঁটিতে।"}]}