{"number":101,"ayahs":[{"number":1,"arabic":"ٱلۡقَارِعَةُ","bengali":"করাঘাতকারী"},{"number":2,"arabic":"مَا ٱلۡقَارِعَةُ","bengali":"করাঘাতকারী কি"},{"number":3,"arabic":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ","bengali":"করাঘাতকারী সম্পর্কে আপনি কি জানেন"},{"number":4,"arabic":"يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ","bengali":"যেদিন মানুষ হবে বিক্ষিপ্ত পতংগের মত"},{"number":5,"arabic":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ","bengali":"এবং পর্বতমালা হবে ধুনিত রঙ্গীন পশমের মত।"},{"number":6,"arabic":"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ","bengali":"অতএব যার পাল্লা ভারী হবে"},{"number":7,"arabic":"فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ","bengali":"সে সুখীজীবন যাপন করবে।"},{"number":8,"arabic":"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ","bengali":"আর যার পাল্লা হালকা হবে"},{"number":9,"arabic":"فَأُمُّهُۥ هَاوِيَةٞ","bengali":"তার ঠিকানা হবে হাবিয়া।"},{"number":10,"arabic":"وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ","bengali":"আপনি জানেন তা কি"},{"number":11,"arabic":"نَارٌ حَامِيَةُۢ","bengali":"প্রজ্জ্বলিত অগ্নি"}]}