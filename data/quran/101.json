  "number": 101,
  "ayahs": [
    {
      "number": 1,
      "arabic": "اَلْقَارِعَةُ ۝١ۙ",
      "bengali": "মহা বিপদ"
    },
    {
      "number": 2,
      "arabic": "مَا الْقَارِعَةُ ۝٢ۚ",
      "bengali": "কী সেই মহা বিপদ?"
    },
    {
      "number": 3,
      "arabic": "وَمَا͏ٓ اَدْرٰىكَ مَا الْقَارِعَةُ ۝٣ؕ",
      "bengali": "মহা বিপদ সম্পর্কে তুমি কী জান?"
    },
    {
      "number": 4,
      "arabic": "يَوْمَ يَكُوْنُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوْثِ ۝٤ۙ",
      "bengali": "সে দিন মানুষ হবে বিক্ষিপ্ত পতঙ্গের মত"
    },
    {
      "number": 5,
      "arabic": "وَتَكُوْنُ الْجِبَالُ كَالْعِهْنِ الْمَنْفُوْشِ ۝٥ؕ",
      "bengali": "আর পর্বতগুলো হবে ধুনা রঙ্গিন পশমের মত।"
    },
    {
      "number": 6,
      "arabic": "فَاَمَّا مَنْ ثَقُلَتْ مَوَازِيْنُهٗ ۝٦ۙ",
      "bengali": "অতঃপর যার (সৎ কর্মের) পাল্লা ভারি হবে।"
    },
    {
      "number": 7,
      "arabic": "فَهُوَ فِيْ عِيْشَةٍ رَّاضِيَةٍ ۝٧ؕ",
      "bengali": "সে সুখী জীবন যাপন করবে।"
    },
    {
      "number": 8,
      "arabic": "وَاَمَّا مَنْ خَفَّتْ مَوَازِيْنُهٗ ۝٨ۙ",
      "bengali": "আর যার (সৎকর্মের) পাল্লা হালকা হবে,"
    },
    {
      "number": 9,
      "arabic": "فَاُمُّهٗ هَاوِيَةٌ ۝٩ؕ",
      "bengali": "(জাহান্নামের) অতলস্পর্শী গর্তই হবে তার বাসস্থান।"
    },
    {
      "number": 10,
      "arabic": "وَمَا͏ٓ اَدْرٰىكَ مَا هِيَهْ ۝١٠ؕ",
      "bengali": "তুমি কি জান তা কী?"
    },
    {
      "number": 11,
      "arabic": "نَارٌ حَامِيَةٌ ۝١١ࣖ",
      "bengali": "জ্বলন্ত আগুন।"
    }
