{
  "number": 80,
  "ayahs": [
    {
      "number": 1,
      "arabic": "عَبَسَ وَتَوَلّٰٓي ۝١ۙ",
      "bengali": "(নবী) মুখ ভার করল আর মুখ ঘুরিয়ে নিল।"
    },
    {
      "number": 2,
      "arabic": "اَنْ جَا࢜ءَهُ الْاَعْمٰى ۝٢ؕ",
      "bengali": "(কারণ সে যখন কুরায়শ সরদারদের সাথে আলোচনায় রত ছিল তখন) তার কাছে এক অন্ধ ব্যক্তি আসল।"
    },
    {
      "number": 3,
      "arabic": "وَمَا يُدْرِيْكَ لَعَلَّهٗ يَزَّكّٰٓي ۝٣ۙ",
      "bengali": "(হে নবী!) তুমি কি জান, সে হয়ত পরিশুদ্ধ হত।"
    },
    {
      "number": 4,
      "arabic": "اَوْ يَذَّكَّرُ فَتَنْفَعَهُ الذِّكْرٰى ۝٤ؕ",
      "bengali": "কিংবা উপদেশ গ্রহণ করত, ফলে উপদেশ তার উপকারে লাগত।"
    },
    {
      "number": 5,
      "arabic": "اَمَّا مَنِ اسْتَغْنٰى ۝٥ۙ",
      "bengali": "পক্ষান্তরে যে পরোয়া করে না,"
    },
    {
      "number": 6,
      "arabic": "فَاَنْتَ لَهٗ تَصَدّٰى ۝٦ؕ",
      "bengali": "তার প্রতি তুমি মনোযোগ দিচ্ছ।"
    },
    {
      "number": 7,
      "arabic": "وَمَا عَلَيْكَ اَلَّا يَزَّكّٰى ۝٧ؕ",
      "bengali": "সে পরিশুদ্ধ না হলে তোমার উপর কোন দোষ নেই।"
    },
    {
      "number": 8,
      "arabic": "وَاَمَّا مَنْ جَا࢜ءَكَ يَسْعٰى ۝٨ۙ",
      "bengali": "পক্ষান্তরে যে লোক তোমার কাছে ছুটে আসল।"
    },
    {
      "number": 9,
      "arabic": "وَهُوَ يَخْشٰى ۝٩ۙ",
      "bengali": "আর সে ভয়ও করে,"
    },
    {
      "number": 10,
      "arabic": "فَاَنْتَ عَنْهُ تَلَهّٰى ۝١٠ۚ",
      "bengali": "তুমি তার প্রতি অমনোযোগী হলে।"
    },
    {
      "number": 11,
      "arabic": "كَلَّا͏ٓ اِنَّهَا تَذْكِرَةٌ ۝١١ۚ",
      "bengali": "না, এটা মোটেই ঠিক নয়, এটা তো উপদেশ বাণী,"
    },
    {
      "number": 12,
      "arabic": "فَمَنْ شَا࢜ءَ ذَكَرَهٗ ۝١٢ۘ",
      "bengali": "কাজেই যার ইচ্ছে তা স্মরণে রাখবে,"
    },
    {
      "number": 13,
      "arabic": "فِيْ صُحُفٍ مُّكَرَّمَةٍ ۝١٣ۙ",
      "bengali": "(এটা লিপিবদ্ধ আছে) মর্যাদাসম্পন্ন কিতাবসমূহে"
    },
    {
      "number": 14,
      "arabic": "مَّرْفُوْعَةٍ مُّطَهَّرَةٍۭ ۝١٤ۙ",
      "bengali": "সমুন্নত, পবিত্র।"
    },
    {
      "number": 15,
      "arabic": "بِاَيْدِيْ سَفَرَةٍ ۝١٥ۙ",
      "bengali": "(এমন) লেখকদের হাতে"
    },
    {
      "number": 16,
      "arabic": "كِرَامٍۭ بَرَرَةٍ ۝١٦ؕ",
      "bengali": "(যারা) মহা সম্মানিত পূত-পবিত্র।"
    },
    {
      "number": 17,
      "arabic": "قُتِلَ الْاِنْسَانُ مَا͏ٓ اَكْفَرَهٗ ۝١٧ؕ",
      "bengali": "মানুষ ধ্বংস হোক! কোন্ জিনিস তাকে সত্য প্রত্যাখ্যানে উদ্বুদ্ধ করল?"
    },
    {
      "number": 18,
      "arabic": "مِنْ اَيِّ شَيْءٍ خَلَقَهٗ ۝١٨ؕ",
      "bengali": "আল্লাহ তাকে কোন বস্তু হতে সৃষ্টি করেছেন?"
    },
    {
      "number": 19,
      "arabic": "مِنْ نُّطْفَةٍؕ خَلَقَهٗ فَقَدَّرَهٗ ۝١٩ۙ",
      "bengali": "শুক্রবিন্দু হতে। তিনি তাকে সৃষ্টি করেছেন, অতঃপর তাকে পরিমিতভাবে গড়ে তুলেছেন।"
    },
    {
      "number": 20,
      "arabic": "ثُمَّ السَّبِيْلَ يَسَّرَهٗ ۝٢٠ۙ",
      "bengali": "অতঃপর তিনি (উপায়-উপকরণ ও প্রয়োজনীয় দ্রব্যসামগ্রী দিয়ে জীবনে চলার জন্য) তার পথ সহজ করে দিয়েছেন।"
    },
    {
      "number": 21,
      "arabic": "ثُمَّ اَمَاتَهٗ فَاَقْبَرَهٗ ۝٢١ۙ",
      "bengali": "অতঃপর তার মৃত্যু ঘটান এবং তাকে কবরস্থ করেন।"
    },
    {
      "number": 22,
      "arabic": "ثُمَّ اِذَا شَا࢜ءَ اَنْشَرَهٗ ۝٢٢ؕ",
      "bengali": "অতঃপর যখন তিনি চাইবেন তাকে আবার জীবিত করবেন।"
    },
    {
      "number": 23,
      "arabic": "كَلَّا لَمَّا يَقْضِ مَا͏ٓ اَمَرَهٗ ۝٢٣ؕ",
      "bengali": "না, মোটেই না, আল্লাহ তাকে যে নির্দেশ দিয়ে ছিলেন তা সে এখনও পূর্ণ করেনি।"
    },
    {
      "number": 24,
      "arabic": "فَلْيَنْظُرِ الْاِنْسَانُ اِلٰى طَعَامِهٖٓ ۝٢٤ۙ",
      "bengali": "মানুষ তার খাদ্যের ব্যপারটাই ভেবে দেখুক না কেন।"
    },
    {
      "number": 25,
      "arabic": "اَنَّا صَبَبْنَا الْمَا࢜ءَ صَبًّا ۝٢٥ۙ",
      "bengali": "আমি প্রচুর পানি ঢালি,"
    },
    {
      "number": 26,
      "arabic": "ثُمَّ شَقَقْنَا الْاَرْضَ شَقًّا ۝٢٦ۙ",
      "bengali": "তারপর যমীনকে বিদীর্ণ করে দেই,"
    },
    {
      "number": 27,
      "arabic": "فَاَنۢ͏ْبَتْنَا فِيْهَا حَبًّا ۝٢٧ۙ",
      "bengali": "অতঃপর তাতে আমি উৎপন্ন করি-শস্য,"
    },
    {
      "number": 28,
      "arabic": "وَّعِنَبًا وَّقَضْبًا ۝٢٨ۙ",
      "bengali": "আঙ্গুর, তাজা শাক-শব্জী,"
    },
    {
      "number": 29,
      "arabic": "وَّزَيْتُوْنًا وَّنَخْلًا ۝٢٩ۙ",
      "bengali": "যয়তূন, খেজুর,"
    },
    {
      "number": 30,
      "arabic": "وَّحَدَا࢜ىِٕقَ غُلْبًا ۝٣٠ۙ",
      "bengali": "আর ঘন বৃক্ষ পরিপূর্ণ বাগবাগিচা,"
    },
    {
      "number": 31,
      "arabic": "وَّفَاكِهَةً وَّاَبًّا ۝٣١ۙ",
      "bengali": "আর নানান জাতের ফল আর ঘাস-লতাপাতা।"
    },
    {
      "number": 32,
      "arabic": "مَّتَاعًا لَّكُمْ وَلِاَنْعَامِكُمْ ۝٣٢ؕ",
      "bengali": "তোমাদের আর তোমাদের গৃহপালিত পশুগুলোর ভোগের জন্য।"
    },
    {
      "number": 33,
      "arabic": "فَاِذَا جَا࢜ءَتِ الصَّا࢜خَّةُ ۝٣٣ؗ",
      "bengali": "অবশেষে যখন কান-ফাটানো শব্দ আসবে;"
    },
    {
      "number": 34,
      "arabic": "يَوْمَ يَفِرُّ الْمَرْءُ مِنْ اَخِيْهِ ۝٣٤ۙ",
      "bengali": "সেদিন মানুষ পালিয়ে যাবে তার ভাই থেকে,"
    },
    {
      "number": 35,
      "arabic": "وَاُمِّهٖ وَاَبِيْهِ ۝٣٥ۙ",
      "bengali": "তার মা, তার বাপ,"
    },
    {
      "number": 36,
      "arabic": "وَصَاحِبَتِهٖ وَبَنِيْهِ ۝٣٦ؕ",
      "bengali": "তার স্ত্রী ও তার সন্তান থেকে,"
    },
    {
      "number": 37,
      "arabic": "لِكُلِّ امْرِي͏ٔ͏ٍ مِّنْهُمْ يَوْمَىِٕذٍ شَاْنٌ يُّغْنِيْهِ ۝٣٧ؕ",
      "bengali": "সেদিন তাদের প্রত্যেকেই নিজেকে নিয়ে ব্যতিব্যস্ত থাকবে।"
    },
    {
      "number": 38,
      "arabic": "وُجُوْهٌ يَّوْمَىِٕذٍ مُّسْفِرَةٌ ۝٣٨ۙ",
      "bengali": "সেদিন কতক মুখ উজ্জ্বল হবে,"
    },
    {
      "number": 39,
      "arabic": "ضَاحِكَةٌ مُّسْتَبْشِرَةٌ ۝٣٩ۚ",
      "bengali": "সহাস্য, উৎফুল্ল।"
    },
    {
      "number": 40,
      "arabic": "وَوُجُوْهٌ يَّوْمَىِٕذٍ عَلَيْهَا غَبَرَةٌ ۝٤٠ۙ",
      "bengali": "সেদিন কতক মুখ হবে ধূলিমলিন।"
    },
    {
      "number": 41,
      "arabic": "تَرْهَقُهَا قَتَرَةٌ ۝٤١ؕ",
      "bengali": "কালিমা ওগুলোকে আচ্ছন্ন করবে।"
    },
    {
      "number": 42,
      "arabic": "اُولٰ࢜ىِٕكَ هُمُ الْكَفَرَةُ الْفَجَرَةُ ۝٤٢ࣖ",
      "bengali": "তারাই আল্লাহকে প্রত্যাখ্যানকারী, পাপাচারী।"
    }
  ]
}
