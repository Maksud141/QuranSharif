{
  "number": 104,
  "ayahs": [
    {
      "number": 1,
      "arabic": "وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةِ ۝١ۙ",
      "bengali": "দুর্ভোগ এমন প্রত্যেক ব্যক্তির জন্য যে (সামনাসামনি) মানুষের নিন্দা করে আর (অসাক্ষাতে) দুর্নাম করে,"
    },
    {
      "number": 2,
      "arabic": "اࣙلَّذِيْ جَمَعَ مَالًا وَّعَدَّدَهٗ ۝٢ۙ",
      "bengali": "যে ধন-সম্পদ জমা করে আর বার বার গণনা করে,"
    },
    {
      "number": 3,
      "arabic": "يَحْسَبُ اَنَّ مَالَهٗٓ اَخْلَدَهٗ ۝٣ۚ",
      "bengali": "সে মনে করে যে, তার ধন-সম্পদ চিরকাল তার সাথে থাকবে,"
    },
    {
      "number": 4,
      "arabic": "كَلَّا لَيُنۢ͏ْبَذَنَّ فِي الْحُطَمَةِ ۝٤ؗۖ",
      "bengali": "কক্ষনো না, তাকে অবশ্যই চূর্ণ-বিচূর্ণকারীর মধ্যে নিক্ষেপ করা হবে,"
    },
    {
      "number": 5,
      "arabic": "وَمَا͏ٓ اَدْرٰىكَ مَا الْحُطَمَةُ ۝٥ؕ",
      "bengali": "তুমি কি জান চূর্ণ-বিচূর্ণকারী কী?"
    },
    {
      "number": 6,
      "arabic": "نَارُ اللّٰهِ الْمُوْقَدَةُ ۝٦ۙ",
      "bengali": "তা আল্লাহর প্রজ্জ্বলিত আগুন,"
    },
    {
      "number": 7,
      "arabic": "الَّتِيْ تَطَّلِعُ عَلَي الْاَفْـِٕدَةِ ۝٧ؕ",
      "bengali": "যা হৃদয় পর্যন্ত পৌঁছে যাবে।"
    },
    {
      "number": 8,
      "arabic": "اِنَّهَا عَلَيْهِمْ مُّو͏ٔ͏ْصَدَةٌ ۝٨ۙ",
      "bengali": "তা তাদেরকে চতুর্দিক থেকে পরিবেষ্টন করে রাখবে,"
    },
    {
      "number": 9,
      "arabic": "فِيْ عَمَدٍ مُّمَدَّدَةٍ ۝٩ࣖ",
      "bengali": "(লেলিহান অগ্নিশিখার) উঁচু উঁচু স্তম্ভে।"
    }
  ]
}
